# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lunch_route
DB_SSL=false
DB_CA=

# --- ตอน deploy (Aiven) ใช้ค่าจากหน้า service ของ Aiven แทน ---
# DB_HOST=<ชื่อ>.aivencloud.com
# DB_PORT=<พอร์ตของ Aiven>
# DB_USER=avnadmin
# DB_PASSWORD=<รหัสจาก Aiven>
# DB_NAME=defaultdb
# DB_SSL=true
# DB_CA=<เนื้อหาใบรับรอง CA>

# ต้องตรงทุกตัวอักษร ไม่มี / ปิดท้าย คั่นด้วย ,
CORS_ORIGINS=http://localhost:4200
